// Compact DriveLang feature tour.
// Run from the repository root: drive run examples/intro.drive

import std::core;
import std::color;
import std::advanced;
import std::kernels;

filter bg_slate() {
    r = 18;
    g = 20;
    b = 26;
}

filter border(thickness) {
    let edge = (x < thickness) or (x >= width - thickness)
        or (y < thickness) or (y >= height - thickness);
    r = edge * 50 + (not edge) * r;
    g = edge * 220 + (not edge) * g;
    b = edge * 255 + (not edge) * b;
}

fn make_card(title, detail, red, green, blue) {
    let background = blank(720, 720)
        -> bg_slate()
        -> grid(48, 28, 34, 44)
        -> vignette(0.7)
        -> border(8);
    let artwork = frame("examples/bw_high_contrast.png")
        -> resize(656, 360)
        -> vivid()
        -> vignette(0.6);
    let heading = text(title, "examples/georgia.ttf", 48, red, green, blue);
    let caption = text(detail, "examples/georgia.ttf", 28, 210, 215, 225);
    return background
        -> blend(32, 48, artwork, 0.9)
        -> blend(32, 455, heading, 0.9)
        -> blend(32, 555, caption, 0.9);
}

for page in 0..15 {
    if page == 0 {
        title = "DRIVELANG";
        detail = "A pipeline DSL for media editing.";
        red = 255; green = 100; blue = 145;
    } elif page == 1 {
        title = "What is it?";
        detail = "Load. Filter. Pipe. Export.";
        red = 100; green = 220; blue = 200;
    } elif page == 2 {
        title = "No GUI. No bloat.";
        detail = "Write the pipeline. Run it. Done.";
        red = 125; green = 180; blue = 255;
    } elif page == 3 {
        title = "Image pipelines";
        detail = "Load a frame, chain filters, export.";
        red = 255; green = 190; blue = 100;
    } elif page == 4 {
        title = "Write your own filter";
        detail = "Pixel math, parameters, and reuse.";
        red = 190; green = 145; blue = 255;
    } elif page == 5 {
        title = "Spatial masks";
        detail = "Apply filters to selected image regions.";
        red = 120; green = 235; blue = 150;
    } elif page == 6 {
        title = "Convolution kernels";
        detail = "Blur, sharpen, emboss, and detect edges.";
        red = 100; green = 200; blue = 255;
    } elif page == 7 {
        title = "Math built in";
        detail = "Use sin, sqrt, clamp, lerp, and more.";
        red = 255; green = 210; blue = 150;
    } elif page == 8 {
        title = "Audio too";
        detail = "Filter samples with time and sample rate.";
        red = 100; green = 255; blue = 170;
    } elif page == 9 {
        title = "Compositing";
        detail = "Blend frames, resize, crop, and export.";
        red = 255; green = 170; blue = 180;
    } elif page == 10 {
        title = "Import. Reuse. Share.";
        detail = "Organize filters into reusable modules.";
        red = 145; green = 220; blue = 255;
    } elif page == 11 {
        title = "Loops and conditions";
        detail = "Automate repeated media operations.";
        red = 130; green = 210; blue = 255;
    } elif page == 12 {
        title = "Standard library";
        detail = "Image, color, audio, and kernel tools.";
        red = 225; green = 180; blue = 255;
    } elif page == 13 {
        title = "Open source";
        detail = "Built in Rust. Runs as a CLI tool.";
        red = 255; green = 230; blue = 190;
    } else {
        title = "Made with DriveLang";
        detail = "One script can render the whole deck.";
        red = 255; green = 100; blue = 145;
    }

    card = make_card(title, detail, red, green, blue);
    path = f"Outputs/slide_{page + 1:02}.png";
    export(card, path);
    print(f"Rendered {title} to {path}\n");
}
