// 10_full_pipeline.drive
// A complete example combining imports, custom filters, kernels,
// audio processing, compositing, and export.

import std::color;
import std::kernels;
import std::audio;

kernel emboss = [
    [-2, -1,  0],
    [-1,  1,  1],
    [ 0,  1,  2]
];

filter hue_rotate(angle) {
    let cosA = cos(angle);
    let sinA = sin(angle);
    let nr = r * (0.213 + cosA * 0.787 - sinA * 0.213)
           + g * (0.715 - cosA * 0.715 - sinA * 0.715)
           + b * (0.072 - cosA * 0.072 + sinA * 0.928);
    let ng = r * (0.213 - cosA * 0.213 + sinA * 0.143)
           + g * (0.715 + cosA * 0.285 + sinA * 0.140)
           + b * (0.072 - cosA * 0.072 - sinA * 0.283);
    let nb = r * (0.213 - cosA * 0.213 - sinA * 0.787)
           + g * (0.715 - cosA * 0.715 + sinA * 0.715)
           + b * (0.072 + cosA * 0.928 + sinA * 0.072);
    r = clamp(nr, 0, 255);
    g = clamp(ng, 0, 255);
    b = clamp(nb, 0, 255);
}

af soft_chime(freq) {
    let sample = sin(6.2831853 * freq * time) * 0.25;
    l = sample;
    r = sample;
}

// --- Image pipeline ---
base   = frame("examples/bw_high_contrast.png") -> resize(1280, 720);
badge  = frame("examples/bw_high_contrast.png") -> resize(80, 80);
label  = text("DriveLang", "examples/georgia.ttf", 24, 200, 200, 200);

result = base
    -> hue_rotate(0.5)
    -> blur(2)
    -> emboss()[0..640, 0..100]
    -> blend(16, 16, badge, 0.9)
    -> blend(16, 110, label, 1.0)
    -> crop(0, 0, 1280, 720);

export(result, "Outputs/full_pipeline.png");

// --- Audio pipeline ---
sfx = silence(1.5, 44100, 2)
    -> soft_chime(660)
    -> hard_clip(0.8)
    -> fade_in(0.2)
    -> fade_out(0.3);
export(sfx, "Outputs/full_pipeline_audio.wav");

print("Done.");
