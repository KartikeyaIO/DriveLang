// 04_kernels.drive
// Define a custom sharpening kernel and use the built-in dynamic blur.

kernel sharpen = [
    [ 0, -1,  0],
    [-1,  5, -1],
    [ 0, -1,  0]
];

img = frame("examples/bw_high_contrast.png");

// Apply custom sharpen kernel
sharpened = img -> sharpen();

// Generate and apply a dynamic 9-by-9 box-blur kernel at runtime.
blurred = img -> blur(9);

export(sharpened, "Outputs/sharpened.png");
export(blurred, "Outputs/blurred.png");
