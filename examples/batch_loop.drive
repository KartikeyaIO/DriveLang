// batch_loop.drive
// Process the same source image with several parameter values and export
// numbered results using the current f-string support.

filter cool_grade() {
    r = clamp(r * 0.85, 0, 255);
    g = clamp(g * 0.95, 0, 255);
    b = clamp(b * 1.15, 0, 255);
}

filter grain(strength) {
    let noise = sin(x * 127 + y * 311) * strength;
    r = clamp(r + noise, 0, 255);
    g = clamp(g + noise, 0, 255);
    b = clamp(b + noise, 0, 255);
}

img = frame("input_image.jpg");
for i in 0..4 {
    result = img -> cool_grade() -> grain(i * 0.5);
    path = f"Outputs/batch_grade_{i:04}.png";
    export(result, path);
    print(f"Wrote {path}\n");
}
