// Make and process a short synthetic tone; no external audio file is needed.
import std::audio;

af tone(freq, level) {
    let sample = sin(6.2831853 * freq * time) * level;
    l = sample;
    r = sample;
}

silence_track = silence(2.0, 44100, 2);
processed = silence_track
    -> tone(220, 0.35)
    -> tremolo(4, 0.25)
    -> hard_clip(0.9)
    -> gain(-4)
    -> fade_in(0.15)
    -> fade_out(0.25);

export(processed, "Outputs/audio_processed.wav");
