// examples/math_and_functions.drive
// Demonstrates:
// 1. Feature 2: Math functions callable at script level (sin, cos, sqrt, clamp, lerp, pow, etc.)
// 2. Feature 12: User-defined functions (fn) with loops inside
// 3. Feature 7: if / elif / else inside functions and scripts
// 4. Feature 5: Escape sequences (\n, \t, \", \\)
// 5. Feature 6: Formatted strings (f"...") with float precision formatting (:.2f)

// User-defined function with a loop inside to compute factorials or power accumulations
fn compute_harmonic_sum(n) {
    let sum = 0.0;
    for i in 1..n {
        sum = sum + 1.0 / i;
    }
    return sum;
}

// User-defined function with multi-branch if / elif / else
fn classify_intensity(val, max_limit) {
    let ratio = val / max_limit;
    if ratio < 0.25 {
        return 1; // Low
    } elif ratio < 0.75 {
        return 2; // Medium
    } else {
        return 3; // High
    }
}

// 1. Mathematical built-ins at top-level script
pi = 3.14159265359;
sin_val = sin(pi / 6.0);       // ~0.5
cos_val = cos(pi / 3.0);       // ~0.5
sqrt_val = sqrt(pow(3.0, 2.0) + pow(4.0, 2.0)); // 5.0
lerp_val = lerp(10.0, 50.0, 0.5); // 30.0
clamped = clamp(150.0, 0.0, 100.0); // 100.0
rounded = round(4.65);
rem = mod(17, 5); // 2

// 2. Calling user-defined functions
harmonic_10 = compute_harmonic_sum(11);
category = classify_intensity(75.0, 100.0);

// 3. Printing results with escape sequences and formatted strings
print("=== Mathematical Library & Functions Demo ===\n");
print(f"Trigonometry:\n\tsin(pi/6) = {sin_val:.2f}\n\tcos(pi/3) = {cos_val:.2f}\n");
print(f"Geometry:\n\tHypotenuse sqrt(3^2 + 4^2) = {sqrt_val:.2f}\n");
print(f"Interpolation & Bounds:\n\tlerp(10, 50, 0.5) = {lerp_val:.2f}\n\tclamp(150, 0, 100) = {clamped:.2f}\n");
print(f"Rounding & Modulo:\n\tround(4.65) = {rounded}\n\tmod(17, 5) = {rem}\n");
print(f"Loops in Functions:\n\tHarmonic series H(10) = {harmonic_10:.2f}\n");
print(f"Function Category: {category}\n");

print("Finished math and user function demo successfully!\n");
